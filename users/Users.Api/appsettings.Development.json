{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": ""
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "",
    "Password": ""
  },
  "Keycloak": {
    "realm": "users",
    "auth-server-url": "http://localhost:8080/",
    "ssl-required": "none",
    "resource": "user",
    "verify-token-audience": true,
    "credentials": {
      "secret": ""
    },
    "enableRolesMapping": "ResourceAccess",
    "roleClaimType": "resource_access.user.roles"
  },
  "KeycloakAdmin": {
    "realm": "master",
    "auth-server-url": "http://localhost:8080/",
    "ssl-required": "none",
    "resource": "users-admin",
    "verify-token-audience": true,
    "credentials": {
      "secret": ""
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  }
}
